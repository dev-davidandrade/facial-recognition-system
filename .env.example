FACE_ACCESS_ENVIRONMENT=development
FACE_ACCESS_LOG_LEVEL=INFO
POSTGRES_PORT=5432
POSTGRES_PASSWORD=local-development-only
FACE_ACCESS_DATABASE_URL=postgresql+psycopg://face_access:local-development-only@localhost:5432/face_access
FACE_ACCESS_DATABASE_HEALTHCHECK_ENABLED=true
FACE_ACCESS_YUNET_MODEL_PATH=models/face_detection_yunet.onnx
FACE_ACCESS_SFACE_MODEL_PATH=models/face_recognition_sface.onnx
FACE_ACCESS_MAX_UPLOAD_BYTES=8388608
FACE_ACCESS_MAX_IMAGE_PIXELS=16000000
FACE_ACCESS_MINIMUM_ENROLLMENT_IMAGES=2
FACE_ACCESS_MAXIMUM_ENROLLMENT_IMAGES=10
FACE_ACCESS_DETECTION_SCORE_THRESHOLD=0.90
FACE_ACCESS_VERIFICATION_SIMILARITY_THRESHOLD=0.50
FACE_ACCESS_IDENTIFICATION_SIMILARITY_THRESHOLD=0.50
FACE_ACCESS_IDENTIFICATION_MINIMUM_MARGIN=0.05
FACE_ACCESS_MIN_FACE_SIZE_PX=80
FACE_ACCESS_MIN_BLUR_SCORE=80.0
FACE_ACCESS_MIN_BRIGHTNESS=45.0
FACE_ACCESS_MAX_BRIGHTNESS=210.0
FACE_ACCESS_MAX_ABSOLUTE_POSE_DEGREES=30.0
FACE_ACCESS_TEMPORAL_CONFIRMATIONS=3
FACE_ACCESS_TEMPORAL_WINDOW_SIZE=5
FACE_ACCESS_TEMPORAL_MAX_GAP_MS=1000
